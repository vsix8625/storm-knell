// Stormfile for Storm-Knell (sk)
cc: /usr/bin/gcc
cflags: -Wall -Werror -Wextra -pedantic
lflags: -lxxhash

if(bootstrap)
{
    print: "Building bootstrapped sk..."
    cflags:: -std=c2x
}
else
{
    cflags:: -std=c23
    linker:  mold
}

if(__os__ == "linux")
{
    print: "Linux detected"
    defines:: -D_GNU_SOURCE
    cflags::  -pthread
    lflags::  -lpthread
}

// You can set the desired global arena size by uncommenting this define and re-building
// Default size is 128 MB, reserverd not allocated.
// defines:: -DSK_ARENA_SIZE_MB=256

major: 0
minor: 18
patch: 2

codegen src/config.h
{
    literal: "#pragma once"

    define: SK_VERSION_MAJOR major
    define: SK_VERSION_MINOR minor
    define: SK_VERSION_PATCH patch
    define: SK_VERSION_STRING "major.minor.patch"

    literal: '#if __has_include("sk_git.h")'
    literal: '#include "sk_git.h"'
    literal: "#endif"
    literal: "#ifndef SK_GIT_HEAD"
    literal: '#define SK_GIT_HEAD "unknown"'
    literal: "#endif"
}

codegen src/sk_git.h
{
    literal: "#pragma once"
    define: SK_GIT_HEAD __git_head__
}

target sk
{
    out: sk
    mode: release

    print: __sk_version__

    if(__has_mbmi__)
    {
        cflags:: -mbmi
    }

    if(fopt)
    {
        print: "Toggled full aggressive optimizations & stripping"
        cflags::
            -O3
            -flto=auto
            -fno-semantic-interposition
            -fdevirtualize-at-ltrans
            -ftree-vectorize
        lflags::
            -flto=auto
            -Wl,-O1
            -Wl,--as-needed
            -Wl,--gc-sections
            -Wl,-s
    }
    else
    {
        cflags:: -O2
    }

    cflags::
        -march=native
        -mlzcnt -Wvla -Wcast-align
        -Wredundant-decls
        -Wmissing-noreturn
        -fvisibility=hidden
        -DNDEBUG

    if(__os__ == "linux")
    {
        exclude::
            external/vx/src/win32/
            external/vx/src/macos/
    }

    sources:
        src/
        external/vx/src/
    includes:
        -Isrc
        -Isrc/core
        -Isrc/core/cli
        -Isrc/core/commands
        -Isrc/core/dsl
        -Isrc/core/hash
        -Isrc/core/invoke
        -Isrc/core/memory
        -Isrc/core/sk_cache
        -Isrc/core/util
        -Iexternal/vx/include
}

// sk strike --set=dev
if(dev)
{
    cc: /usr/bin/clang // will override gcc from top and use clang for this target
    linker: lld
    target skdev
    {
        out: skdev
        mode: debug

        // defines can also be set in cflags
        cflags:: -g -DDEBUG

        if(__os__ == "linux")
        {
            exclude::
                external/vx/src/win32/
                external/vx/src/macos/
        }

        sources:
            src/
            external/vx/src/

        includes:
            -Isrc
            -Isrc/core
            -Isrc/core/cli
            -Isrc/core/commands
            -Isrc/core/dsl
            -Isrc/core/hash
            -Isrc/core/invoke
            -Isrc/core/memory
            -Isrc/core/sk_cache
            -Isrc/core/util
            -Iexternal/vx/include

        install: ~/.local/bin
    }
}
