cc: /usr/bin/clang
linker: lld // becomes --fuse-ld=lld

cflags:
    -std=c17
    -Wall
    -Wextra
    -Werror
    -O3
    -march=native

lflags:
    -lreadline
    -lm
    -ldl
    -Wl,-O1
    -Wl,--as-needed

defines:
    -DNDEBUG
    -DLUA_USE_LINUX
    -DLUA_USE_READLINE

target lua_sk
{
    out: lua_sk
    out_dir: lua_sk
    mode: release

    sources:
        lapi.c
        lauxlib.c
        lbaselib.c
        lcode.c
        lcorolib.c
        lctype.c
        ldblib.c
        ldebug.c
        ldo.c
        ldump.c
        lfunc.c
        lgc.c
        linit.c
        liolib.c
        llex.c
        lmathlib.c
        lmem.c
        loadlib.c
        lobject.c
        lopcodes.c
        loslib.c
        lparser.c
        lstate.c
        lstring.c
        lstrlib.c
        ltable.c
        ltablib.c
        ltm.c
        lundump.c
        lutf8lib.c
        lvm.c
        lzio.c
        lua.c
}
