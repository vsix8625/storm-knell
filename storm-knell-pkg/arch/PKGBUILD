# Maintainer: vsix8625 <panagiotis.panteli.dev@gmail.com>
pkgname="storm-knell"
pkgver=0.17.9
pkgrel=1

pkgdesc="A C/C++ build and project automation tool"
arch=(x86_64)
url="https://github.com/vsix8625/storm-knell"
license=('MIT')
depends=(glibc xxhash)
makedepends=(gcc)
optdepends=('bash-completion: tab completion for sk')
options=(!debug)
install=
changelog=
source=("https://github.com/vsix8625/storm-knell/releases/download/v${pkgver}/storm-knell-${pkgver}.tar.gz")
noextract=()

sha256sums=('2e1af191c20bdb8fcc12eae691cfecc1c05770766c65026726d741bcb1754e3e')

validpgpkeys=()

build() {
	cd "$pkgname-$pkgver"
	bash scripts/build_linux.sh
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 crater/sk/release/bin/sk "$pkgdir/usr/bin/sk"
	install -Dm644 utils/bash/sk_completion.sh "$pkgdir/usr/share/bash-completion/completions/sk"
}
